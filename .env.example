# Copy to .env and fill in. .env is git-ignored.

# --- Amazon Bedrock (provider: bedrock) ---
AWS_REGION=us-east-1
# Any model IDs / inference profiles enabled in your account.
# Tip: use a different model family for the judge than for the generator.
GENERATOR_MODEL=<bedrock-model-id-for-the-assistant>
JUDGE_MODEL=<bedrock-model-id-for-the-judge>

# --- OpenAI (provider: openai) ---
# OPENAI_API_KEY=sk-...
# GENERATOR_MODEL=<openai-model>
# JUDGE_MODEL=<openai-model>
